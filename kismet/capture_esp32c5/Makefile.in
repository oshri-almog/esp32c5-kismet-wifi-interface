# Builds kismet_cap_esp32c5, the esp32c5 capture helper, from capture_esp32c5.c and the
# capture framework in ../libkismetdatasource.a, with Kismet's own flags and libraries
# (../Makefile.inc). kismet/add-to-kismet.sh copies it into a Kismet source tree, as
# capture_esp32c5/Makefile.in, and adds that directory to configure.ac, from which
# ./configure makes the Makefile; Kismet's top-level make builds and installs the helper
# with the others.

include ../Makefile.inc

MONITOR_OBJS = \
	capture_esp32c5.c.o
MONITOR_BIN = kismet_cap_esp32c5

all: $(MONITOR_BIN)

$(MONITOR_BIN):	$(MONITOR_OBJS) $(patsubst %c.o,%c.d,$(MONITOR_OBJS)) ../libkismetdatasource.a
		$(CCLD) $(LDFLAGS) -o $(MONITOR_BIN) $(MONITOR_OBJS) ../libkismetdatasource.a $(DATASOURCE_LIBS)

clean:
	@-rm -f $(MONITOR_BIN)
	@-rm -f *.o
	@-rm -f *.d

%.c.o:	%.c
%.c.o : %.c %.c.d
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $*.c -o $@

%.c.d:	%.c
	$(CC) -MM $(CFLAGS) $(CPPFLAGS) $*.c | sed -e "s/\.o/\.c.o/" > $*.c.d

.PRECIOUS: %.c.d

include $(wildcard $(patsubst %c.o,%c.d,$(MONITOR_OBJS)))

