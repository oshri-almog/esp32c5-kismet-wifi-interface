+/* Does warn_login_ampersand warn about these arguments?  Its stderr, caught in a file */
+static bool warns_ampersand(char **argv) {
+    char path[128], buf[1024] = "";
+    int argc = 0, fd, saved;
+    ssize_t n;
+
+    while (argv[argc] != NULL)
+        argc++;
+    snprintf(path, sizeof(path), "%s/stderr", tree);
+    fflush(stderr);
+    saved = dup(2);
+    fd = open(path, O_CREAT | O_TRUNC | O_RDWR, 0600);
+    dup2(fd, 2);
+    warn_login_ampersand(argc, argv);
+    fflush(stderr);
+    dup2(saved, 2);
+    close(saved);
+    lseek(fd, 0, SEEK_SET);
+    n = read(fd, buf, sizeof(buf) - 1);
+    buf[n > 0 ? n : 0] = '\0';
+    close(fd);
+    unlink(path);
+    return strstr(buf, "WARNING: the Kismet user name or password contains '&'") != NULL &&
+        strstr(buf, "use an API key (--apikey or KISMET_CAP_APIKEY)") != NULL;
+}
