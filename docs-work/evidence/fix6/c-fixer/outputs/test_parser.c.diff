+    check(gc > 0 && opened && !alive, "setuid root: serial_open asks for it again, and the capture "
+            "process still ends with its parent (%s)", own);
+    if (gc > 0 && alive)
+        kill(gc, SIGKILL);
+    close(m);
+}
