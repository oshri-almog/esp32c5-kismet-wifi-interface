+def ampersand_in_login(args):
+    """What of the websocket login holds '&' -- "user name", "password" or both -- or None.
+
+    Kismet cannot take such a login from any client. Its server percent-decodes the whole query of the
+    websocket's address and only then splits it into variables at '&' (decode_get_variables() in
+    kis_net_beast_httpd.cc), so the %26 this helper writes for '&' comes out as a separator all the same,
+    and the login it checks is cut short. An API key is hex, and has no such trouble."""
+    if args.tcp or args.user is None:
+        return None
+    parts = [what for what, value in (("user name", args.user), ("password", args.password)) if "&" in (value or "")]
+    return " and ".join(parts) or None
+
